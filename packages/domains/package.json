{
  "name": "@lokascript/domains",
  "version": "4.0.1",
  "description": "The LokaScript multilingual domain-DSL family in one package: SQL, flow, behavior specs, BDD, LLM prompts, todo, voice and learn, each multilingual. Subpath exports per domain; the root entry wires the full registry.",
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "import": "./dist/sql.js"
    },
    "./flow": {
      "types": "./dist/flow.d.ts",
      "import": "./dist/flow.js"
    },
    "./bdd": {
      "types": "./dist/bdd.d.ts",
      "import": "./dist/bdd.js"
    },
    "./behaviorspec": {
      "types": "./dist/behaviorspec.d.ts",
      "import": "./dist/behaviorspec.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js"
    },
    "./todo": {
      "types": "./dist/todo.d.ts",
      "import": "./dist/todo.js"
    },
    "./voice": {
      "types": "./dist/voice.d.ts",
      "import": "./dist/voice.js"
    },
    "./learn": {
      "types": "./dist/learn.d.ts",
      "import": "./dist/learn.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "pretest": "../../scripts/ensure-fresh.sh ../domain-sql ../domain-flow ../domain-bdd ../domain-behaviorspec ../domain-llm ../domain-todo ../domain-voice ../domain-learn ../domain-config && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.gate.json",
    "pregate:regen": "../../scripts/ensure-fresh.sh ../domain-sql ../domain-flow ../domain-bdd ../domain-behaviorspec ../domain-llm ../domain-todo ../domain-voice ../domain-learn ../domain-config && npm run build",
    "gate:regen": "tsx scripts/regen-round-trip-baseline.ts"
  },
  "peerDependencies": {
    "@lokascript/framework": "^4.7.0",
    "@lokascript/intent": "^4.0.0",
    "@lokascript/semantic": "^4.0.0"
  },
  "devDependencies": {
    "@lokascript/domain-bdd": "^4.0.1",
    "@lokascript/domain-behaviorspec": "^4.0.1",
    "@lokascript/domain-config": "^4.0.1",
    "@lokascript/domain-flow": "^4.0.1",
    "@lokascript/domain-learn": "^4.0.1",
    "@lokascript/domain-llm": "^4.0.1",
    "@lokascript/domain-sql": "^4.0.1",
    "@lokascript/domain-todo": "^4.0.1",
    "@lokascript/domain-voice": "^4.0.1",
    "@lokascript/framework": "^4.7.0",
    "@lokascript/intent": "^4.7.0",
    "@lokascript/semantic": "^4.7.0",
    "@types/node": "^26.1.2",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "multilingual",
    "dsl",
    "i18n",
    "sql",
    "bdd",
    "flow",
    "llm",
    "lokascript",
    "framework"
  ],
  "author": "LokaScript Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/lokascript-domains.git",
    "directory": "packages/domains"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
