{
  "name": "@lokascript/domain-config",
  "version": "7.1.0",
  "description": "Shared domain-registry wiring + priority order for MCP servers and other consumers. Single source of truth for which LokaScript domains exist and how the dispatcher breaks ambiguity.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --noEmit false",
    "pretest": "../../scripts/ensure-fresh.sh ../domain-sql ../domain-behaviorspec ../domain-todo ../domain-llm ../domain-flow ../domain-voice",
    "test": "vitest",
    "test:run": "vitest run",
    "test:check": "VITEST_QUIET=1 bash ../../scripts/vitest-run.sh --reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lokascript/domain-behaviorspec": "^7.1.0",
    "@lokascript/domain-flow": "^7.1.0",
    "@lokascript/domain-llm": "^7.1.0",
    "@lokascript/domain-sql": "^7.1.0",
    "@lokascript/domain-todo": "^7.1.0",
    "@lokascript/domain-voice": "^7.1.0",
    "@lokascript/framework": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/lokascript-domains.git",
    "directory": "packages/domain-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true
}
